# EVA Platform - Configuración de Entorno
# Copiar este archivo a .env y ajustar credenciales según el entorno

# ========================================
# PostgreSQL Configuration
# ========================================
POSTGRES_DB=mlplatform
POSTGRES_USER=mluser
POSTGRES_PASSWORD=mlpass
DB_PORT=5432

# ========================================
# MinIO (Object Storage) Configuration
# ========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ========================================
# EVA Platform Configuration
# ========================================
EVA_MAX_ROWS=12000
EVA_MLFLOW_TRACKING_URI=http://mlflow:5000
EVA_MLFLOW_EXPERIMENT_NAME=eva_proxy_safe

# ========================================
# MLflow Configuration
# ========================================
MLFLOW_PORT=5000

# ========================================
# API Configuration
# ========================================
API_PORT=8000

# ========================================
# Frontend Configuration
# ========================================
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ========================================
# Docker Hub Configuration
# ========================================
DOCKER_HUB_USER=diegovasquez600
DOCKER_REGISTRY=docker.io

# ========================================
# NOTA DE SEGURIDAD
# ========================================
# Para PRODUCCIÓN:
# 1. Cambiar POSTGRES_PASSWORD a una contraseña fuerte
# 2. Cambiar MINIO_ROOT_PASSWORD a una contraseña fuerte
# 3. Nunca commitear .env al repositorio (ya está en .gitignore)
# 4. Usar un gestor de secretos (AWS Secrets Manager, HashiCorp Vault, etc.)
# 5. Configurar SSL/TLS con certificados válidos
# 6. Restringir acceso de red con firewalls
# 7. Usar variables de entorno del sistema operativo en lugar de archivos .env
